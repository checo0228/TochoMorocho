# Copia este archivo como .env.local y llena los valores (Supabase → Project Settings → API Keys).
# En Vercel: Settings → Environment Variables (las mismas 3 primeras).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave pública ("publishable" sb_publishable_… o la "anon" antigua)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave SECRETA ("secret" sb_secret_… o la "service_role" antigua). Solo servidor. NUNCA subir al repo.
SUPABASE_SECRET_KEY=

# Solo para `npm run usuarios:crear` (6 números cada uno). Bórralos después de correrlo.
# Solo se tocan los que tengan valor. Cada PIN tiene su propia lista de impresión.
PIN_ADMIN=
PIN_EMPLEADAS=
# Opcional: un PIN (y una lista) por empleada. Formato: Nombre:123456,Otra:234567
EMPLEADAS=
